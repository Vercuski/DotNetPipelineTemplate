<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PipelineTemplate.Domain\PipelineTemplate.Domain.csproj" />
    <ProjectReference Include="..\PipelineTemplate.Application\PipelineTemplate.Application.csproj" />
    <ProjectReference Include="..\PipelineTemplate.Infrastructure\PipelineTemplate.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Package identity finalized per ADR-0010 — checked for collisions against
      nuget.org before confirming; this PackageId matches the PackageReference in
      templates/PipelineTemplate.Template/PipelineApp.csproj.
    -->
    <PackageId>DotNetPipelineTemplate.Core</PackageId>
    <Version>1.0.0</Version>
    <Description>Generic, domain-agnostic Pipes and Filters implementation for .NET 10 — a thin facade over the Domain/Application/Infrastructure layers, so consumers reference one package.</Description>
  </PropertyGroup>

  <!--
    This project is deliberately a pure facade: no source files of its own, just
    ProjectReferences to the three layer projects. It exists so external consumers
    have one package/short-name to reference (finalized per ADR-0010), while the
    actual code stays organized by Clean Architecture layer for maintainers.
    `dotnet pack` on this project pulls in Domain/Application/Infrastructure as
    package dependencies automatically, since they're also packable (each has its
    own PackageId) — see local-nuget-feed/ and the README for the local-testing
    workflow, which packs all four.
  -->

</Project>
