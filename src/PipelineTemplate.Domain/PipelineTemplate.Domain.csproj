<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- PLACEHOLDER package identity — see PipelineTemplate.Core.csproj for the full note. -->
    <PackageId>DotNetPipelineTemplate.Domain</PackageId>
    <Version>1.0.0</Version>
    <Description>Pure contracts and rules of the Pipes and Filters pattern — zero dependencies.</Description>
  </PropertyGroup>

  <!--
    No package dependencies, and none should ever be added here without real
    scrutiny — this is the innermost Clean Architecture layer. Every type in this
    project is a contract (IFilter, IErrorPolicy, IPipelineObserver) or a pure,
    stateless rule (FailFastPolicy, SkipAndContinuePolicy). Orchestration,
    defaults, and anything with a real external dependency belongs in Application
    or Infrastructure instead.
  -->

</Project>
