<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Phase 1 development only: the Core Library isn't published to nuget.org yet
      (architecture-vision.md §10 — package identity is still an open decision).
      This local folder feed is populated by `dotnet pack src/PipelineTemplate.Core
      -o local-nuget-feed` and lets the Template Package's PackageReference actually
      resolve while developing. Remove this source once a real package is published.
    -->
    <add key="local-phase1-feed" value="./local-nuget-feed" />
  </packageSources>
</configuration>
