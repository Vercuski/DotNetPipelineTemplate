<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Package identity finalized per ADR-0010. Still resolves against the local
      feed at ../../local-nuget-feed via an explicit `dotnet restore --source` (see
      README.md "Trying the template locally") rather than an ambient NuGet.config,
      since a repo-root config would affect every other project's restore too —
      that's a packaging-workflow choice, unrelated to the naming decision. Swap
      the version constraint once a real published version exists.
    -->
    <PackageReference Include="DotNetPipelineTemplate.Core" Version="1.0.0" />
  </ItemGroup>

</Project>
